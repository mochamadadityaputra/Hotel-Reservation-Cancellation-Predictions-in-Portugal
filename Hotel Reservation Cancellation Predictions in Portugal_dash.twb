                </zone>
                <zone h='67375' id='22' type-v2='text' w='615' x='63769' y='25000'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='33250' id='13' type-v2='text' w='28693' x='6692' y='26875'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='13'>⏰ </run>
                    <run bold='true' fontcolor='#141413' fontname='Tableau Medium' fontsize='13'>Tiered cancellation policy</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#3d3d3a' fontname='Tableau Regular' fontsize='11'>No charge &gt;7 days out · 50% fee H-6 to H-1 · Non-refundable on day of arrival. Targets the spike at day 0.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='33250' id='15' type-v2='text' w='28692' x='35385' y='26875'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='13'>📅 </run>
                    <run bold='true' fontcolor='#141413' fontname='Tableau Medium' fontsize='13'>Separate peak/off-peak policy</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#3d3d3a' fontname='Tableau Regular' fontsize='11'>July &amp; August need stricter policies. Non-peak months can use flexible rules to attract more bookings.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='33250' id='17' type-v2='text' w='28692' x='64077' y='26875'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='13'>🔗 </run>
                    <run bold='true' fontcolor='#141413' fontname='Tableau Medium' fontsize='13'>Incentivize direct booking</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#3d3d3a' fontname='Tableau Regular' fontsize='11'>Offer discounts for direct reservations and require deposits for OTA/agent bookings to reduce no-shows.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='1250' id='25' type-v2='text' w='88923' x='5385' y='57250'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='33250' id='14' type-v2='text' w='28693' x='6692' y='58000'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='13'>💰 </run>
                    <run bold='true' fontcolor='#141413' fontname='Tableau Medium' fontsize='13'>Off-peak ADR promotions</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#3d3d3a' fontname='Tableau Regular' fontsize='11'>When ADR &gt;€80 off-peak, cancellations rise. Offer late check-out or dinner perks to retain bookings.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='33250' id='16' type-v2='text' w='28692' x='35385' y='58000'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='13'>👨‍👩‍👧 </run>
                    <run bold='true' fontcolor='#141413' fontname='Tableau Medium' fontsize='13'>Family &amp; loyalty programs</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#3d3d3a' fontname='Tableau Regular' fontsize='11'>Family amenities (playground, ramps) and loyalty rewards reduce churn across guest segments.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='33250' id='18' type-v2='text' w='28692' x='64077' y='58000'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='13'>📣 </run>
                    <run bold='true' fontcolor='#141413' fontname='Tableau Medium' fontsize='13'>Last-minute promotion engine</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#3d3d3a' fontname='Tableau Regular' fontsize='11'>Push multilingual last-minute deals on social media or other platform to fill rooms freed by day-of cancellations.</run>
                  </formatted-text>
                  <zone-style>

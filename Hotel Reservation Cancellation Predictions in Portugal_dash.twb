        </aliases>
      </column>
      <column caption='Cancellation Rate (Table Calc))' datatype='real' name='[Calculation_1352952219332608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_canceled]) / SUM(1)' />
      </column>
      <column caption='Guest Type' datatype='string' name='[Calculation_1352952224354312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_repeated_guest] = 1 THEN &quot;Repeat Guest&quot;&#13;&#10;ELSE &quot;New Guest&quot;&#13;&#10;END' />
      </column>
      <column caption='Box' datatype='string' name='[Calculation_1582197996744704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Cancellation flag' datatype='string' name='[Calculation_1720187008577536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_canceled] = 1 THEN &quot;Cancelled&quot; ELSE &quot;Confirmed&quot; END' />
      </column>
      <column caption='Revenue Per Booking' datatype='real' name='[Calculation_1720187008679937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[adr] * ([stays_in_week_nights] + [stays_in_weekend_nights])' />
      </column>
      <column caption='Confirmed revenue' datatype='real' name='[Calculation_1720187008790530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_canceled] = 0 THEN [Calculation_1720187008679937] ELSE 0 END' />
      </column>
      <column caption='Lost revenue (cancelled)' datatype='real' name='[Calculation_1720187008851971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_canceled] = 1 THEN [Calculation_1720187008679937] ELSE 0 END' />
      </column>
      <column caption='Cancellation rate %' datatype='real' default-format='p0.0%' name='[Calculation_1720187008946180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_canceled]) / COUNT([is_canceled])' />
      </column>
      <column caption='Lead time bucket' datatype='string' name='[Calculation_1720187009081349]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [day_diff] = 0 THEN &quot;D-0 (Day of)&quot;&#13;&#10;ELSEIF [day_diff] = 1 THEN &quot;D-1&quot;&#13;&#10;ELSEIF [day_diff] = 2 THEN &quot;D-2&quot;&#13;&#10;ELSEIF [day_diff] = 3 THEN &quot;D-3&quot;&#13;&#10;ELSEIF [day_diff] = 4 THEN &quot;D-4&quot;&#13;&#10;ELSEIF [day_diff] = 5 THEN &quot;D-5&quot;&#13;&#10;ELSEIF [day_diff] = 6 THEN &quot;D-6&quot;&#13;&#10;ELSE &quot;D-7+&quot;&#13;&#10;END' />
      </column>
      <column caption='ADR tier' datatype='string' name='[Calculation_1720187009224710]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [adr] &gt;= 80 THEN &quot;High ADR (≥€80)&quot; ELSE &quot;Low ADR (&lt;€80)&quot; END' />
      </column>
      <column caption='Hotel Filter Selector' datatype='boolean' name='[Calculation_1720187045134353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;All&quot; THEN TRUE&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;City Hotel&quot; AND [hotel] = &quot;City Hotel&quot; THEN TRUE&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Resort Hotel&quot; AND [hotel] = &quot;Resort Hotel&quot; THEN TRUE&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;High Season&quot; AND [arrival_date_month] IN (&quot;July&quot;, &quot;August&quot;) THEN TRUE&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Off-peak&quot; AND ([arrival_date_month] != &quot;July&quot; AND [arrival_date_month] != &quot;August&quot;) THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>

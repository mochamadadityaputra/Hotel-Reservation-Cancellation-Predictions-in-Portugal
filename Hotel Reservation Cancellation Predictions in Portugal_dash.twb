    <worksheet name='KPI Metrics Value'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Hotel_Bookings_Cleaned)' name='federated.1gonnb01a227pd14wqyf71spjwyg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All Hotels' caption='Hotel Filter' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All Hotels' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gonnb01a227pd14wqyf71spjwyg'>
            <column caption='Guest Type' datatype='string' name='[Calculation_1352952224354312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_repeated_guest] = 1 THEN &quot;Repeat Guest&quot;&#13;&#10;ELSE &quot;New Guest&quot;&#13;&#10;END' />
            </column>
            <column caption='Cancellation flag' datatype='string' name='[Calculation_1720187008577536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_canceled] = 1 THEN &quot;Cancelled&quot; ELSE &quot;Confirmed&quot; END' />
            </column>
            <column caption='Revenue Per Booking' datatype='real' name='[Calculation_1720187008679937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[adr] * ([stays_in_week_nights] + [stays_in_weekend_nights])' />

              <calculation class='tableau' formula='IF [is_repeated_guest] = 1 THEN &quot;Repeat Guest&quot;&#13;&#10;ELSE &quot;New Guest&quot;&#13;&#10;END' />
            </column>
            <column caption='Cancellation flag' datatype='string' name='[Calculation_1720187008577536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_canceled] = 1 THEN &quot;Cancelled&quot; ELSE &quot;Confirmed&quot; END' />

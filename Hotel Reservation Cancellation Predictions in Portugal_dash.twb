          </zone>
          <zone h='6500' id='58' type-v2='dashboard-object' w='16307' x='22231' y='9250'>
            <button action='tabdoc:goto-sheet window-id=&quot;{50B5DD2D-745C-40F4-9353-D19E6CE365C2}&quot;' button-type='text'>
              <button-visual-state>
                <caption>Deep Dive</caption>
                <button-caption-font-style bold='true' fontcolor='#555555' fontname='Tableau Medium' fontsize='12' />
              </button-visual-state>
            </button>
            <zone-style>
              <format attr='border-color' value='#000000' />
